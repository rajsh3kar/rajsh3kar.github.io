---
import Layout from '../layouts/Layout.astro';

const interests = [
  "ML systems",
  "EdgeAI",
  "Federated learning",
  "Reinforcement learning",
  "Edge computing",
  "MLOps",
  "UAV networks",
  "Distributed systems",
];

const papers = [
  {
    venue: "Journal of Network and Systems Management",
    year: "2025",
    note: "SCI Q1",
    title: "Optimizing Drone Deployment for Maximized User Connectivity in Areas of Interest Via Deep Reinforcement Learning",
    summary: "Deep reinforcement learning for placing drones so more users stay connected inside an area of interest.",
    href: "https://link.springer.com/article/10.1007/s10922-025-09924-1",
  },
  {
    venue: "Ad Hoc Networks",
    year: "2025",
    note: "SCI Q1",
    title: "A Deep Learning-based Approach for Heterogeneous Hotspot-Coverage in UAV Deployment",
    summary: "A deep-learning approach to covering uneven demand hotspots when deploying UAVs.",
    href: "https://www.sciencedirect.com/science/article/pii/S1570870525003750",
  },
  {
    venue: "Journal of Network and Systems Management",
    year: "2024",
    note: "SCI Q1",
    title: "Reinforcement Learning for Real-Time Federated Learning for Resource-Constrained Edge Cluster",
    summary: "Reinforcement learning that runs real-time federated learning on a resource-constrained edge cluster.",
    href: "https://link.springer.com/article/10.1007/s10922-024-09857-1",
  },
];

const news = [
  {
    date: "March 2025",
    text: "Started as a postdoctoral researcher at the University of Innsbruck, on the DATAPACT project.",
  },
  {
    date: "January 2025",
    text: "Two papers published in SCI Q1 journals: Ad Hoc Networks and the Journal of Network and Systems Management.",
  },
  {
    date: "December 2024",
    text: "Defended my PhD at IIT Bhilai. Dissertation: Machine Learning for Optimizing Resources in Edge Computing.",
  },
];
---

<Layout title="Kolichala Rajashekar">
  <div class="grid items-start gap-10 lg:grid-cols-[15.5rem_minmax(0,1fr)] lg:gap-16">
    <aside class="lg:sticky lg:top-8">
      <div class="sm:flex sm:items-start sm:gap-5 lg:block">
        <div class="h-32 w-32 shrink-0 overflow-hidden rounded-2xl bg-stone-300 sm:h-28 sm:w-28 lg:aspect-square lg:h-auto lg:w-full">
          <img
            src="/prof_pic.jpeg"
            alt="Kolichala Rajashekar"
            class="h-full w-full origin-[center_16%] scale-[1.72] object-cover"
          />
        </div>
        <div class="mt-4 min-w-0 sm:mt-0 lg:mt-5">
          <h1 class="font-serif text-[1.7rem] font-semibold leading-tight text-ink">Kolichala Rajashekar</h1>
          <p class="mt-1 text-sm font-medium text-stone-500">Ph.D.</p>
          <p class="mt-2 text-[0.95rem] font-semibold text-primary">Postdoctoral Researcher</p>
          <p class="text-[0.95rem] text-stone-700">University of Innsbruck</p>
          <p class="text-sm text-stone-500">Innsbruck, Austria</p>
          <nav aria-label="Contact" class="mt-4 flex flex-wrap gap-x-3 gap-y-1 text-sm">
            <a href="mailto:rajashekar.kolichala@uibk.ac.at" class="text-primary underline decoration-primary/30 underline-offset-4 hover:decoration-primary">Email</a>
            <a href="https://scholar.google.com/citations?user=wq36gfgAAAAJ" target="_blank" rel="noopener" class="text-primary underline decoration-primary/30 underline-offset-4 hover:decoration-primary">Scholar</a>
            <a href="https://github.com/rajsh3kar" target="_blank" rel="noopener" class="text-primary underline decoration-primary/30 underline-offset-4 hover:decoration-primary">GitHub</a>
            <a href="https://www.linkedin.com/in/kolichala-rajashekar-a20b37a3" target="_blank" rel="noopener" class="text-primary underline decoration-primary/30 underline-offset-4 hover:decoration-primary">LinkedIn</a>
            <a href="https://twitter.com/rajsh3kar" target="_blank" rel="noopener" class="text-primary underline decoration-primary/30 underline-offset-4 hover:decoration-primary">X</a>
          </nav>
        </div>
      </div>
    </aside>

    <div class="space-y-14">
      <section>
        <p class="max-w-2xl text-lg leading-relaxed text-stone-800">
          I am a postdoctoral researcher at the University of Innsbruck, working on
          <a href="https://datapact.eu" target="_blank" rel="noopener" class="font-semibold text-ink underline decoration-primary/40 underline-offset-4 hover:decoration-primary">DATAPACT</a>,
          a project on compliance-aware data and AI pipelines. My PhD at IIT Bhilai studied machine learning for optimizing resources in edge computing: reinforcement learning for systems, real-time federated learning, and UAV deployment.
        </p>

        <dl class="mt-8 grid grid-cols-1 gap-5 border-y border-stone-300/80 py-5 sm:grid-cols-3">
          <div>
            <dt class="font-serif text-2xl font-semibold text-ink">Innsbruck</dt>
            <dd class="mt-1 text-sm text-stone-600">Postdoctoral researcher</dd>
          </div>
          <div>
            <dt class="font-serif text-2xl font-semibold text-ink">3</dt>
            <dd class="mt-1 text-sm text-stone-600">SCI Q1 journal papers</dd>
          </div>
          <div>
            <dt class="font-serif text-2xl font-semibold text-ink">ICDCN</dt>
            <dd class="mt-1 text-sm text-stone-600">Best Poster, 2023</dd>
          </div>
        </dl>

        <ul class="mt-6 flex flex-wrap gap-2" aria-label="Research interests">
          {interests.map((interest) => (
            <li class="rounded-full bg-stone-200/70 px-3 py-1 text-sm text-stone-800">{interest}</li>
          ))}
        </ul>
      </section>

      <section>
        <h2 class="font-serif text-2xl font-semibold text-ink">Current work</h2>
        <div class="mt-5 rounded-2xl border border-stone-300/80 bg-white/50 p-6 sm:p-7">
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-primary">University of Innsbruck · 2025–present</p>
          <h3 class="mt-2 font-serif text-[1.7rem] font-semibold leading-tight">
            <a href="https://datapact.eu" target="_blank" rel="noopener" class="hover:text-primary">DATAPACT</a>
          </h3>
          <p class="mt-1 text-stone-600">Compliance-aware data and AI pipelines</p>
          <p class="mt-4 max-w-2xl leading-relaxed text-stone-800">
            Lead architect for a consortium of 14 industry and academic partners. I design the core architecture in the C4 model and orchestrate scalable pipelines with Kubeflow and Kubernetes.
          </p>
        </div>
      </section>

      <section>
        <div class="flex items-baseline justify-between gap-4">
          <h2 class="font-serif text-2xl font-semibold text-ink">Selected papers</h2>
          <a href="/publications" class="text-sm text-primary underline decoration-primary/30 underline-offset-4 hover:decoration-primary">All publications</a>
        </div>
        <div class="mt-2">
          {papers.map((paper) => (
            <article class="border-t border-stone-300/80 py-5">
              <p class="text-xs font-semibold uppercase tracking-[0.12em] text-stone-500">
                {paper.venue} · {paper.year} · {paper.note}
              </p>
              <h3 class="mt-1.5 font-serif text-xl font-semibold leading-snug">
                <a href={paper.href} target="_blank" rel="noopener" class="hover:text-primary">{paper.title}</a>
              </h3>
              <p class="mt-2 max-w-2xl text-stone-700">{paper.summary}</p>
            </article>
          ))}
        </div>
      </section>

      <section>
        <div class="flex items-baseline justify-between gap-4">
          <h2 class="font-serif text-2xl font-semibold text-ink">News</h2>
          <a href="/news" class="text-sm text-primary underline decoration-primary/30 underline-offset-4 hover:decoration-primary">All news</a>
        </div>
        <ol class="mt-2">
          {news.map((item) => (
            <li class="border-t border-stone-300/80 py-4">
              <time class="text-sm text-stone-500">{item.date}</time>
              <p class="mt-1 max-w-2xl text-stone-800">{item.text}</p>
            </li>
          ))}
        </ol>
      </section>
    </div>
  </div>
</Layout>
