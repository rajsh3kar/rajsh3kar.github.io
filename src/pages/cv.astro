---
import Layout from '../layouts/Layout.astro';
---

<Layout title="CV - Kolichala Rajashekar" description="Curriculum vitae of Kolichala Rajashekar, postdoctoral researcher at the University of Innsbruck.">
  <div>
    <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="font-serif text-4xl font-semibold text-ink">Kolichala Rajashekar, Ph.D.</h1>
        <p class="mt-2 text-stone-600">Postdoctoral Researcher · University of Innsbruck, Austria</p>
      </div>
      <button type="button" onclick="window.print()" class="no-print rounded-full border border-primary px-4 py-2 text-sm font-semibold text-primary hover:bg-primary hover:text-white">
        Save as PDF
      </button>
    </div>
    
    <div class="space-y-8">
      <!-- Academic Appointments -->
      <section>
        <h2 class="mb-4 border-b border-stone-300 pb-2 font-serif text-2xl font-semibold text-ink">Academic Appointments</h2>
        <div class="space-y-4">
          <div>
            <div class="mb-1 flex flex-wrap items-start justify-between gap-x-4 gap-y-1">
