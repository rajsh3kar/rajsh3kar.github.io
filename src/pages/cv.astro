            </ul>
          </div>
        </div>
      </section>

      <!-- Education -->
      <section>
        <h2 class="mb-4 border-b border-stone-300 pb-2 font-serif text-2xl font-semibold text-ink">Education</h2>
        <div class="space-y-4">
          <div>
            <div class="mb-1 flex flex-wrap items-start justify-between gap-x-4 gap-y-1">
              <h3 class="text-lg font-semibold">Ph.D. in Computer Science and Engineering</h3>
