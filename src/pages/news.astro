---
import Layout from '../layouts/Layout.astro';

const items = [
  {
    date: "March 2025",
    text: "Started as a postdoctoral researcher at the University of Innsbruck, Austria, on DATAPACT (compliance-aware data and AI pipelines) with a consortium of 14 industry and academic partners.",
  },
  {
    date: "January 2025",
    text: "Paper accepted at the ScaleSyS Workshop, IEEE IoT Conference, Vienna 2025: “Toward Sustainability-Aware LLM Inference on Edge Clusters.”",
  },
  {
    date: "January 2025",
    text: "Paper published in Ad Hoc Networks (SCI Q1): “A Deep Learning-based Approach for Heterogeneous Hotspot-Coverage in UAV Deployment.”",
  },
  {
    date: "January 2025",
    text: "Paper published in the Journal of Network and Systems Management (SCI Q1): “Optimizing Drone Deployment for Maximized User Connectivity in Areas of Interest Via Deep Reinforcement Learning.”",
  },
  {
    date: "December 2024",
    text: "Defended my PhD in Computer Science and Engineering at IIT Bhilai. Dissertation: “Machine Learning for Optimizing Resources in Edge Computing.”",
  },
  {
    date: "October 2024",
    text: "Awarded $5,000 in Google Cloud Research Credits as principal investigator, for work on machine-learning operations and system management.",
  },
  {
    date: "July 2024",
    text: "Paper accepted to the Journal of Network and Systems Management (SCI Q1): “Reinforcement Learning for Real-Time Federated Learning for Resource-Constrained Edge Cluster.”",
  },
  {
    date: "May 2024",
    text: "Presented “Towards a Mobility-cum-Battery Aware Dynamic UAV Deployment for Uninterrupted Connectivity” at IEEE NOMS 2024, Miami.",
  },
  {
    date: "April 2024",
    text: "Received a student travel grant to attend IEEE NOMS 2024.",
  },
  {
    date: "January 2023",
    highlight: true,
    text: "Received the Best Poster Award at ICDCN 2023, IIT Kharagpur, for “Topology-Aware Cluster Configuration for Real-time Multi-access Edge Computing.”",
  },
];
---

<Layout title="News - Kolichala Rajashekar" description="News and updates from Kolichala Rajashekar.">
  <header class="mb-8 max-w-2xl">
    <h1 class="font-serif text-4xl font-semibold text-ink">News</h1>
  </header>

  <ol>
    {items.map((item) => (
      <li class="border-t border-stone-300/80 py-5">
        <time class="text-sm text-stone-500">{item.date}</time>
        <p class:list={["mt-1 max-w-2xl leading-relaxed", item.highlight ? "text-ink" : "text-stone-800"]}>{item.text}</p>
      </li>
    ))}
  </ol>
</Layout>
