---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Publications - Kolichala Rajashekar" description="Journal articles and conference papers by Kolichala Rajashekar.">
  <header class="mb-10 max-w-2xl">
    <h1 class="font-serif text-4xl font-semibold text-ink">Publications</h1>
    <p class="mt-3 text-stone-600">
      Journal articles and conference papers. A complete list is on
      <a href="https://scholar.google.com/citations?user=wq36gfgAAAAJ" target="_blank" rel="noopener" class="text-primary underline decoration-primary/30 underline-offset-4 hover:decoration-primary">Google Scholar</a>.
    </p>
  </header>

  <section class="mb-12">
    <h2 class="font-serif text-2xl font-semibold text-ink">Journals</h2>
    <div class="mt-2">
      <article class="border-t border-stone-300/80 py-5">
        <p class="text-xs font-semibold uppercase tracking-[0.12em] text-stone-500">Journal of Network and Systems Management · 2025 · SCI Q1</p>
        <h3 class="mt-1.5 font-serif text-xl font-semibold leading-snug">Optimizing Drone Deployment for Maximized User Connectivity in Areas of Interest Via Deep Reinforcement Learning</h3>
        <p class="mt-2 text-sm text-stone-600"><strong class="font-semibold text-stone-800">K. Rajashekar</strong>, et al.</p>
        <a href="https://link.springer.com/article/10.1007/s10922-025-09924-1" target="_blank" rel="noopener" class="mt-3 inline-block text-sm text-primary underline decoration-primary/30 underline-offset-4 hover:decoration-primary">Read paper</a>
      </article>

      <article class="border-t border-stone-300/80 py-5">
        <p class="text-xs font-semibold uppercase tracking-[0.12em] text-stone-500">Ad Hoc Networks · 2025 · SCI Q1</p>
        <h3 class="mt-1.5 font-serif text-xl font-semibold leading-snug">A Deep Learning-based Approach for Heterogeneous Hotspot-Coverage in UAV Deployment</h3>
        <p class="mt-2 text-sm text-stone-600"><strong class="font-semibold text-stone-800">K. Rajashekar</strong>, et al.</p>
        <a href="https://www.sciencedirect.com/science/article/pii/S1570870525003750" target="_blank" rel="noopener" class="mt-3 inline-block text-sm text-primary underline decoration-primary/30 underline-offset-4 hover:decoration-primary">Read paper</a>
      </article>

      <article class="border-t border-stone-300/80 py-5">
        <p class="text-xs font-semibold uppercase tracking-[0.12em] text-stone-500">Journal of Network and Systems Management · 2024 · SCI Q1</p>
        <h3 class="mt-1.5 font-serif text-xl font-semibold leading-snug">Reinforcement Learning for Real-Time Federated Learning for Resource-Constrained Edge Cluster</h3>
        <p class="mt-2 text-sm text-stone-600"><strong class="font-semibold text-stone-800">K. Rajashekar</strong>, et al.</p>
        <a href="https://link.springer.com/article/10.1007/s10922-024-09857-1" target="_blank" rel="noopener" class="mt-3 inline-block text-sm text-primary underline decoration-primary/30 underline-offset-4 hover:decoration-primary">Read paper</a>
      </article>
    </div>
  </section>

  <section>
    <h2 class="font-serif text-2xl font-semibold text-ink">Conferences</h2>
    <div class="mt-2">
      <article class="border-t border-stone-300/80 py-5">
        <p class="text-xs font-semibold uppercase tracking-[0.12em] text-stone-500">ScaleSyS Workshop, IEEE IoT Conference · Vienna · 2025</p>
        <h3 class="mt-1.5 font-serif text-xl font-semibold leading-snug">Toward Sustainability-Aware LLM Inference on Edge Clusters</h3>
        <p class="mt-2 text-sm text-stone-600"><strong class="font-semibold text-stone-800">K. Rajashekar</strong>, et al. · Accepted</p>
      </article>

      <article class="border-t border-stone-300/80 py-5">
        <p class="text-xs font-semibold uppercase tracking-[0.12em] text-stone-500">IEEE/IFIP NOMS · Miami · 2024</p>
        <h3 class="mt-1.5 font-serif text-xl font-semibold leading-snug">Towards Mobility cum Battery-aware UAV placement optimization using Reinforcement Learning</h3>
        <p class="mt-2 text-sm text-stone-600"><strong class="font-semibold text-stone-800">K. Rajashekar</strong>, et al.</p>
        <a href="https://ieeexplore.ieee.org/document/10575209" target="_blank" rel="noopener" class="mt-3 inline-block text-sm text-primary underline decoration-primary/30 underline-offset-4 hover:decoration-primary">Read paper</a>
      </article>

      <article class="border-t border-stone-300/80 py-5">
        <p class="text-xs font-semibold uppercase tracking-[0.12em] text-stone-500">EAI MobiQuitous · 2023</p>
        <h3 class="mt-1.5 font-serif text-xl font-semibold leading-snug">Minimizing Data Retrieval Delay In Edge Computing</h3>
        <p class="mt-2 text-sm text-stone-600"><strong class="font-semibold text-stone-800">K. Rajashekar</strong>, et al.</p>
        <a href="https://link.springer.com/chapter/10.1007/978-3-031-63992-0_5" target="_blank" rel="noopener" class="mt-3 inline-block text-sm text-primary underline decoration-primary/30 underline-offset-4 hover:decoration-primary">Read paper</a>
      </article>

      <article class="border-t border-stone-300/80 py-5">
        <p class="text-xs font-semibold uppercase tracking-[0.12em] text-primary">ICDCN · IIT Kharagpur · 2023 · Best Poster Award</p>
        <h3 class="mt-1.5 font-serif text-xl font-semibold leading-snug">Topology-Aware Cluster Configuration for Real-Time Multi-Access Edge Computing</h3>
        <p class="mt-2 text-sm text-stone-600"><strong class="font-semibold text-stone-800">K. Rajashekar</strong>, et al.</p>
        <a href="https://dl.acm.org/doi/pdf/10.1145/3571306.3571417" target="_blank" rel="noopener" class="mt-3 inline-block text-sm text-primary underline decoration-primary/30 underline-offset-4 hover:decoration-primary">Read paper</a>
      </article>

      <article class="border-t border-stone-300/80 py-5">
        <p class="text-xs font-semibold uppercase tracking-[0.12em] text-stone-500">IEEE ICDCS · 2022 · Poster</p>
        <h3 class="mt-1.5 font-serif text-xl font-semibold leading-snug">Topology aware cluster configuration for minimizing communication delay in edge computing</h3>
        <p class="mt-2 text-sm text-stone-600"><strong class="font-semibold text-stone-800">K. Rajashekar</strong>, et al.</p>
        <a href="https://ieeexplore.ieee.org/abstract/document/9912217" target="_blank" rel="noopener" class="mt-3 inline-block text-sm text-primary underline decoration-primary/30 underline-offset-4 hover:decoration-primary">Read paper</a>
      </article>
    </div>
  </section>
</Layout>
